      "filePath": "ui/ventana_principal.py",
      "lineRange": [37, 51],
      "summary": "Zona de previsualizacion clickeable que hereda de `ProporcionImagen` y emite su senal `clicked` cuando se pulsa el boton izquierdo.",
      "tags": ["widget", "componente", "senal", "previsualizacion"],
      "complexity": "simple"
    },
    {
      "id": "class:ui/ventana_principal.py:PantallaPreprocesado",
      "type": "class",
      "name": "PantallaPreprocesado",
      "filePath": "ui/ventana_principal.py",
      "lineRange": [54, 183],
      "summary": "Pantalla principal de preprocesado: permite elegir imagen, alternar el modelo de segmentacion (grabcut/otsu), quitar o restaurar el fondo y navegar a las pantallas de canales o de recorte.",
      "tags": ["pantalla", "preprocesado", "segmentacion", "navegacion"],
      "complexity": "complex"
    },
    {
      "id": "class:ui/ventana_principal.py:VentanaPrincipal",
      "type": "class",
      "name": "VentanaPrincipal",
      "filePath": "ui/ventana_principal.py",
      "lineRange": [186, 251],
      "summary": "QMainWindow que hospeda las cinco pantallas en un QStackedWidget, comparte el estado `EstadoImagen` por referencia, expone senales de cambio y define atajos de teclado entre RGB, YCM y la pantalla principal.",
      "tags": ["ventana", "navegacion", "contenedor", "atajos"],
      "complexity": "moderate"
    },
    {
      "id": "class:ui/ventana_recorte.py:VistaRecorte",
      "type": "class",
      "name": "VistaRecorte",
      "filePath": "ui/ventana_recorte.py",
      "lineRange": [23, 179],
      "summary": "QGraphicsView con marco fijo centrado en el viewport que dibuja un velo oscuro fuera del encuadre, permite zoom y paneo por arrastre y expone la seleccion en coordenadas de la imagen original.",
      "tags": ["widget", "recorte", "zoom", "paneo", "pyside6"],
      "complexity": "complex"
    },
    {
      "id": "class:ui/ventana_recorte.py:VentanaRecorte",
