  "nodes": [
    {
      "id": "file:core/imagen.py",
      "type": "file",
      "name": "imagen.py",
      "filePath": "core/imagen.py",
      "summary": "Modulo de entrada/salida de imagenes: carga RGB de 8 bits, guardado en PNG/RGB/PSD y definicion del dataclass EstadoImagen que las cinco pantallas comparten por referencia.",
      "tags": ["io-imagen", "estado-compartido", "persistencia", "utilidad"],
      "complexity": "moderate",
      "languageNotes": "Dataclass con anotaciones de tipo union (str | None) propias de Python 3.10+; la importacion de psd_tools es perezosa dentro de la funcion para que el resto de la app no dependa de esa libreria."
    },
    {
      "id": "class:core/imagen.py:EstadoImagen",
      "type": "class",
      "name": "EstadoImagen",
      "filePath": "core/imagen.py",
      "lineRange": [22, 39],
      "summary": "Contenedor de estado compartido por las pantallas: guarda la imagen original (RGB uint8 que nunca se modifica), la preprocesada, la mascara, el modelo de segmentacion, el modo, el canal activo, el rango del histograma y el recorte.",
      "tags": ["data-model", "estado-compartido", "dataclass"],
      "complexity": "simple"
    },
    {
      "id": "function:core/imagen.py:cargar_imagen",
      "type": "function",
      "name": "cargar_imagen",
      "filePath": "core/imagen.py",
      "lineRange": [42, 50],
      "summary": "Carga la imagen con IMREAD_COLOR (8 bits, 3 canales) y la convierte de BGR a RGB, lanzando FileNotFoundError si el archivo no se puede leer.",
      "tags": ["io-imagen", "carga", "opencv", "conversion-rgb"],
      "complexity": "simple"
    },
    {
      "id": "function:core/imagen.py:guardar_imagen",
      "type": "function",
      "name": "guardar_imagen",
      "filePath": "core/imagen.py",
      "lineRange": [53, 56],
      "summary": "Guarda la imagen como PNG RGBA con fondo transparente, apilando la mascara como canal alfa con np.dstack.",
      "tags": ["io-imagen", "guardado", "png", "canal-alfa"],
      "complexity": "simple"
    },
    {
      "id": "function:core/imagen.py:guardar_rgb",
      "type": "function",
      "name": "guardar_rgb",
      "filePath": "core/imagen.py",
      "lineRange": [59, 61],
      "summary": "Guarda la imagen tal cual en PNG o JPEG RGB, sin canal alfa, descartando cualquier cuarto canal del array.",
      "tags": ["io-imagen", "guardado", "rgb"],
      "complexity": "simple"
    },
    {
      "id": "function:core/imagen.py:guardar_mascara",
      "type": "function",
      "name": "guardar_mascara",
      "filePath": "core/imagen.py",
      "lineRange": [64, 66],
      "summary": "Guarda la mascara binaria como PNG de 8 bits en escala de grises, con 255 para el objeto y 0 para el fondo.",
      "tags": ["io-imagen", "guardado", "mascara", "escala-de-grises"],
      "complexity": "simple"
    },
    {
      "id": "function:core/imagen.py:guardar_psd",
      "type": "function",
      "name": "guardar_psd",
      "filePath": "core/imagen.py",
      "lineRange": [69, 77],
      "summary": "Exporta un PSD de Photoshop con la capa RGB completa y la mascara como mascara de capa, usando psd_tools.",
      "tags": ["io-imagen", "guardado", "psd", "exportacion"],
      "complexity": "simple",
      "languageNotes": "La importacion de psd_tools es perezosa (dentro de la funcion), de modo que un ImportError solo rompe esta operacion y no el resto de la app."
    },
    {
      "id": "file:core/segmentacion.py",
      "type": "file",
      "name": "segmentacion.py",
      "filePath": "core/segmentacion.py",
      "summary": "Motor de segmentacion del objeto: implementa los modelos grabcut (recorte al 10 % de los bordes sobre copia reducida) y otsu (umbral por canal unido con OR e invertido), mas la limpieza de mascara por flood fill y el contorno de 1 px.",
      "tags": ["segmentacion", "opencv", "mascara-binaria", "procesamiento-de-imagenes"],
      "complexity": "moderate",
      "languageNotes": "La segmentacion trabaja siempre sobre una copia reducida (lado mayor 500 px) y reescala despues la mascara con INTER_NEAREST para no suavizar los bordes."
    },
    {
      "id": "function:core/segmentacion.py:_a_escala",
      "type": "function",
      "name": "_a_escala",
      "filePath": "core/segmentacion.py",
      "lineRange": [22, 32],
      "summary": "Devuelve una copia reducida de la imagen para acelerar la segmentacion, junto con el factor de escala aplicado.",
      "tags": ["utilidad", "escalado", "optimizacion"],
      "complexity": "simple"
    },
    {
      "id": "function:core/segmentacion.py:_devolver_a_escala",
      "type": "function",
      "name": "_devolver_a_escala",
      "filePath": "core/segmentacion.py",
      "lineRange": [35, 41],
      "summary": "Reescala la mascara binaria al tamano original de la imagen con interpolacion INTER_NEAREST para conservar bordes nitidos.",
      "tags": ["utilidad", "escalado", "mascara-binaria"],
      "complexity": "simple"
    },
    {
      "id": "function:core/segmentacion.py:_grabcut",
      "type": "function",
      "name": "_grabcut",
      "filePath": "core/segmentacion.py",
      "lineRange": [44, 54],
      "summary": "Ejecuta GrabCut inicializado con un rectangulo que deja fuera el 10 % de los bordes y convierte las etiquetas de grabcut en una mascara binaria 0/255.",
      "tags": ["segmentacion", "grabcut", "opencv", "mascara-binaria"],
      "complexity": "simple"
    },
    {
      "id": "function:core/segmentacion.py:_otsu",
      "type": "function",
      "name": "_otsu",
      "filePath": "core/segmentacion.py",
      "lineRange": [57, 66],
      "summary": "Calcula el umbral de Otsu canal a canal, une los resultados con OR bitwise e invierte la binaria cuando el blanco es mayoritario.",
      "tags": ["segmentacion", "otsu", "threshold", "mascara-binaria"],
      "complexity": "simple"
    },
    {
      "id": "function:core/segmentacion.py:segmentar",
      "type": "function",
      "name": "segmentar",
      "filePath": "core/segmentacion.py",
      "lineRange": [69, 88],
      "summary": "Punto de entrada de la segmentacion: valida el modelo, segmenta sobre la imagen reducida, devuelve la mascara a escala original y aplica cierre morfologico mas seleccion del componente conexo mayor.",
      "tags": ["segmentacion", "api-publica", "morfologia", "post-procesado"],
      "complexity": "moderate"
    },
    {
      "id": "function:core/segmentacion.py:limpiar_mascara",
      "type": "function",
      "name": "limpiar_mascara",
      "filePath": "core/segmentacion.py",
      "lineRange": [91, 140],
      "summary": "Limpia la mascara binaria: rellena huecos internos con flood fill sembrado en el fondo exterior y descarta las islas cuyo area queda por debajo del umbral indicado.",
      "tags": ["limpieza-de-mascara", "flood-fill", "morfologia", "post-procesado"],
      "complexity": "complex",
      "languageNotes": "La semilla del flood fill se busca primero en el borde de la imagen: sembrarla dentro de un hueco convertiria el fondo exterior en objeto."
    },
    {
      "id": "function:core/segmentacion.py:contorno",
      "type": "function",
      "name": "contorno",
      "filePath": "core/segmentacion.py",
      "lineRange": [143, 156],
      "summary": "Devuelve el perimetro de 1 px del objeto en blanco sobre negro, usando findContours y drawContours sobre la mascara binaria.",
      "tags": ["contorno", "edge-detection", "opencv", "mascara-binaria"],
      "complexity": "simple"
    },
