{
  "nodes": [
    {
      "id": "file:core/canales.py",
      "type": "file",
      "name": "canales.py",
      "filePath": "core/canales.py",
      "summary": "Modulo de calculo puro (sin UI) que extrae los componentes 2D de los canales RGB e YCM de una imagen y los convierte a los modos de visualizacion 'color' y 'blanco y negro', ademas de etiquetar el canal activo en espanol.",
      "tags": ["core", "procesamiento-imagen", "canales", "numpy", "utility"],
      "complexity": "moderate",
      "languageNotes": "Los promedios YCM se calculan en float32 y se castean a uint8 al final para evitar saturacion por desbordamiento."
    },
    {
      "id": "function:core/canales.py:canal_rgb",
      "type": "function",
      "name": "canal_rgb",
      "filePath": "core/canales.py",
      "lineRange": [26, 28],
      "summary": "Devuelve la componente 2D (alto x ancho) del canal R, G o B indexando el tercer eje del array de la imagen.",
      "tags": ["canales", "numpy", "extraccion", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:core/canales.py:componente_ycm",
      "type": "function",
      "name": "componente_ycm",
      "filePath": "core/canales.py",
      "lineRange": [31, 47],
      "summary": "Calcula el componente 2D de Y, C o M como promedio de dos canales (Y=(R+G)/2, C=(G+B)/2, M=(R+B)/2) en float32 y lo castea a uint8; lanza ValueError si la letra no es valida.",
      "tags": ["ycm", "numpy", "conversion", "validacion"],
      "complexity": "moderate"
    },
    {
      "id": "function:core/canales.py:componente",
      "type": "function",
      "name": "componente",
      "filePath": "core/canales.py",
      "lineRange": [50, 56],
      "summary": "Despacha al extractor de componente correcto segun el espacio de color (RGB o YCM) y valida que el espacio sea uno de los dos admitidos.",
      "tags": ["dispatch", "canales", "validacion", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:core/canales.py:modo_color",
      "type": "function",
      "name": "modo_color",
      "filePath": "core/canales.py",
      "lineRange": [59, 81],
      "summary": "Construye el array 3D con la representacion en color del canal pedido (R, G, B, Y, C o M) mediante np.dstack, dejando en cero los componentes no correspondientes.",
      "tags": ["color", "numpy", "renderizado", "canales"],
      "complexity": "moderate"
    },
    {
      "id": "function:core/canales.py:modo_blanco_y_negro",
      "type": "function",
      "name": "modo_blanco_y_negro",
      "filePath": "core/canales.py",
      "lineRange": [84, 86],
      "summary": "Devuelve el componente 2D del canal tal cual, ya que en blanco y negro la imagen resultante es monocromatica.",
      "tags": ["blanco-y-negro", "canales", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:core/canales.py:aplicar_modo",
      "type": "function",
      "name": "aplicar_modo",
      "filePath": "core/canales.py",
      "lineRange": [89, 95],
      "summary": "Punto de entrada que devuelve el array del canal segun el modo 'color' o 'blanco y negro', componiendo el componente 2D cuando el modo es monocromatico.",
      "tags": ["dispatch", "modos", "canales", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:core/canales.py:etiqueta_canal",
      "type": "function",
      "name": "etiqueta_canal",
      "filePath": "core/canales.py",
      "lineRange": [98, 102],
      "summary": "Genera el texto en espanol del canal activo del tipo 'RGB - Azul' o 'YCM - Magenta' a partir del espacio y la letra.",
      "tags": ["etiqueta", "i18n", "canales", "utility"],
      "complexity": "simple"
    },
    {
      "id": "file:ui/helpers.py",
      "type": "file",
      "name": "helpers.py",
      "filePath": "ui/helpers.py",
      "summary": "Ayudas compartidas por las pantallas de la aplicacion: un constructor de QPushButton con tamano fijo de tokens y un envoltorio que traslada el contenido de un layout raiz a un QScrollArea.",
      "tags": ["ui", "utility", "helpers", "widgets"],
      "complexity": "simple",
      "languageNotes": "envolver_en_scroll drena el layout con takeAt(0) para reubicar widgets, layouts y spacers dentro de un QScrollArea resizable."
    },
    {
      "id": "function:ui/helpers.py:boton",
      "type": "function",
      "name": "boton",
      "filePath": "ui/helpers.py",
      "lineRange": [10, 17],
      "summary": "Crea un QPushButton con el texto indicado y, opcionalmente, object_name y tamano fijo, centralizando las medidas 200x60 / 160x48 definidas en los tokens.",
      "tags": ["factory", "boton", "widgets", "ui"],
      "complexity": "simple"
    },
    {
      "id": "function:ui/helpers.py:envolver_en_scroll",
      "type": "function",
      "name": "envolver_en_scroll",
      "filePath": "ui/helpers.py",
      "lineRange": [20, 35],
      "summary": "Traslada todos los widgets, layouts y spacers del layout raiz a un QWidget interno y lo inserta en un QScrollArea resizable para evitar contenido recortado.",
      "tags": ["ui", "scroll", "layout", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "file:ui/ventana_canales.py",
      "type": "file",
      "name": "ventana_canales.py",
      "filePath": "ui/ventana_canales.py",
      "summary": "Implementa la pantalla base de canales: tres lienzos clicables (uno por componente del espacio), selector de modo color/blanco y negro, acceso al histograma y boton REGRESAR, alimentandose siempre de la imagen original.",
      "tags": ["ui", "pantalla", "canales", "pyside6", "componente"],
      "complexity": "moderate",
      "languageNotes": "Aplica el patron signal/slot de Qt (LienzoCanal.clicked) con lambdas de captura por defecto para asociar cada lienzo a su letra de canal."
    },
    {
      "id": "class:ui/ventana_canales.py:LienzoCanal",
