      "filePath": "ui/ventana_canales.py",
      "lineRange": [20, 34],
      "summary": "Lienzo de canal cliceable que extiende ProporcionImagen, emite la signal clicked con el boton izquierdo y usa el cursor de mano para indicar que es interactivo.",
      "tags": ["component", "widget", "signal", "canales"],
      "complexity": "simple"
    },
    {
      "id": "class:ui/ventana_canales.py:VentanaCanales",
